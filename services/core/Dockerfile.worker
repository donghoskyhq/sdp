FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system sdp \
    && adduser --system --ingroup sdp sdp

COPY pyproject.toml ./
COPY src ./src
RUN pip install --upgrade pip \
    && pip install .

USER sdp
CMD ["python", "-m", "worker.main"]
