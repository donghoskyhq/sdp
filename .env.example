# Local development defaults only. Never add real credentials to this file.
SDP_ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=sdp
POSTGRES_USER=sdp
POSTGRES_PASSWORD=sdp-local-only
DATABASE_URL=postgresql+psycopg://sdp:sdp-local-only@localhost:5432/sdp

# Redis / RQ
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=default

# GitHub App installation token (recommended) or fine-grained token. Worker-only secret.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_OWNER_TYPE=organization
GITHUB_API_URL=https://api.github.com
GITHUB_REPOSITORY_PRIVATE=true

# Deployment providers. Tokens are worker-only secrets. Configure both to offer both targets.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_API_URL=https://api.vercel.com

RAILWAY_TOKEN=
RAILWAY_WORKSPACE_ID=
RAILWAY_API_URL=https://backboard.railway.com/graphql/v2

# The worker waits for the first deployment to reach a terminal state.
DEPLOYMENT_POLL_INTERVAL_SECONDS=5
DEPLOYMENT_TIMEOUT_SECONDS=900

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Web server-side URL for FastAPI. This value is not exposed to the browser.
API_BASE_URL=http://localhost:8000
